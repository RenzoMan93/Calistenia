# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings -> API en el panel de Supabase).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la función create-preference (se arma sola con VITE_SUPABASE_URL,
# no hace falta tocar esto salvo que uses un dominio de funciones custom).
